{
  // Stock shadcn components. They are generated by the CLI and never edited, so they are checked
  // here without the two flags they do not satisfy. Everything else stays at maximum strictness;
  // our own code sees these files only through the declarations emitted below.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.tsbuild/ui",
    "tsBuildInfoFile": "./.tsbuild/ui.tsbuildinfo",
    "types": ["vite/client"],
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/components/ui", "src/lib", "src/hooks"]
}
